#!/usr/bin/env bash
# yt-transcribe — download a YouTube URL with yt-dlp and transcribe with FluidAudio.
#
# Defaults:
#   - model version v2 (English, higher recall)
#   - audio cached in /tmp/yt-transcribe (override with $YT_TRANSCRIBE_CACHE)
#   - transcript written to ./<video-title>.md in the current directory
#
# Usage:
#   yt-transcribe <url> [-o out.md] [extra fluidaudiocli args...]
#   yt-transcribe <url> --model-version v3        # override default v2
#   yt-transcribe <url> --word-timestamps --metadata
#
# Any flag the wrapper doesn't consume is forwarded to `fluidaudiocli transcribe`.
set -euo pipefail

FLUIDAUDIO_BIN="${FLUIDAUDIO_BIN:-$HOME/Developer/FluidAudio/.build/release/fluidaudiocli}"
CACHE_DIR="${YT_TRANSCRIBE_CACHE:-/tmp/yt-transcribe}"

if [[ $# -lt 1 ]]; then
    echo "usage: yt-transcribe <youtube-url> [-o out.md] [fluidaudiocli args...]" >&2
    exit 64
fi

URL="$1"; shift

OUT_PATH=""
FORWARD_ARGS=()
USER_SET_MODEL=0

while [[ $# -gt 0 ]]; do
    case "$1" in
        -o|--output)
            OUT_PATH="$2"; shift 2 ;;
        --model-version)
            USER_SET_MODEL=1
            FORWARD_ARGS+=("$1" "$2"); shift 2 ;;
        --)
            shift; FORWARD_ARGS+=("$@"); break ;;
        *)
            FORWARD_ARGS+=("$1"); shift ;;
    esac
done

if [[ $USER_SET_MODEL -eq 0 ]]; then
    FORWARD_ARGS+=(--model-version v2)
fi

if [[ ! -x "$FLUIDAUDIO_BIN" ]]; then
    echo "fluidaudiocli not found at $FLUIDAUDIO_BIN" >&2
    echo "build it with: (cd ~/Developer/FluidAudio && swift build -c release)" >&2
    exit 70
fi

mkdir -p "$CACHE_DIR"

# Stable per-URL filename so repeated runs reuse the cached download.
SLUG="$(printf '%s' "$URL" | shasum | cut -c1-12)"
TARGET="$CACHE_DIR/$SLUG.m4a"

echo ">> fetching title" >&2
TITLE="$(yt-dlp --no-warnings --skip-download --print '%(title)s' "$URL" 2>/dev/null || true)"
[[ -z "$TITLE" ]] && TITLE="$SLUG"

if [[ -z "$OUT_PATH" ]]; then
    # Sanitize title: keep alnum, dash, underscore, space; collapse the rest to '-'.
    SAFE="$(printf '%s' "$TITLE" | LC_ALL=C tr -c '[:alnum:]._ -' '-' | tr -s '-' | sed 's/^-//;s/-$//')"
    OUT_PATH="./${SAFE:-$SLUG}.md"
fi

if [[ ! -s "$TARGET" ]]; then
    echo ">> downloading audio to $TARGET" >&2
    yt-dlp -f 'bestaudio[ext=m4a]/bestaudio' \
           --extract-audio --audio-format m4a \
           -o "$TARGET" \
           "$URL" >&2
fi

echo ">> transcribing -> $OUT_PATH" >&2
TRANSCRIPT="$("$FLUIDAUDIO_BIN" transcribe "$TARGET" "${FORWARD_ARGS[@]}")"

{
    printf '# %s\n\n' "$TITLE"
    printf 'Source: %s\n\n' "$URL"
    printf '%s\n' "$TRANSCRIPT"
} > "$OUT_PATH"

echo "$OUT_PATH"
